# ─────────────────────────────────────────────────────────────────────────────
# Lab 07 — Testing, Evaluation & Observability (.NET path)
# Copy to .env (place it in this src-dotnet folder) and fill in your values.
# AppSupport.LoadDotEnv() walks up from the build output and picks this up.
# Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Target agent (reused from Lab 03) ---
# Azure AI Foundry project endpoint (AI Foundry project overview page).
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
# The same endpoint + deployment are reused as the LLM judge for --online.
PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Deployed chat model used by the agent under test and the judge (e.g., gpt-4o).
MODEL_DEPLOYMENT_NAME=gpt-4o

# --- Tracing (Azure Monitor / Application Insights) ---
# Required only for '--task trace'. Copy from the Application Insights resource
# linked to the Foundry project (Overview -> Connection String).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Opt in to message-content capture ONLY in non-production with approval.
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
