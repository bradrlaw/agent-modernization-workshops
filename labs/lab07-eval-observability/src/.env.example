# ─────────────────────────────────────────────────────────────────────────────
# Lab 07 — Testing, Evaluation & Observability (Python path)
# Copy to .env and fill in your values. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- Target agent (reused from Lab 03) ---
# Azure AI Foundry project endpoint (AI Foundry project overview page).
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Deployed chat model used by the agent under test (e.g., gpt-4o, gpt-4.1)
MODEL_DEPLOYMENT_NAME=gpt-4o

# --- Evaluation (azure-ai-evaluation quality evaluators) ---
# Azure OpenAI endpoint + deployment of the model used AS THE JUDGE.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
EVALUATOR_MODEL_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Tracing (Azure Monitor / Application Insights) ---
# Either set the connection string directly, or leave blank to pull it from the
# Application Insights resource linked to the Foundry project.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Opt in to message-content capture ONLY in non-production with approval.
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# --- AI Red Teaming (Python-only, preview) ---
# Foundry project endpoint used by the red teaming agent (often same as above).
AZURE_AI_PROJECT=https://your-resource.services.ai.azure.com/api/projects/your-project
