# Copy to .env in this folder (or reuse labs/lab03-foundry-agent/src/.env).
# The Microsoft Agent Framework reads FOUNDRY_PROJECT_ENDPOINT / FOUNDRY_MODEL;
# the Lab 03 names (PROJECT_ENDPOINT / MODEL_DEPLOYMENT_NAME) are accepted as fallbacks.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-4o

# Which demo customer this session acts as (see data/customers.json: CUST-1001..1003).
DEMO_CUSTOMER_ID=CUST-1001

# Cross-session memory backend for the Agent -> Memory demo (Lab 06 follow-up). Optional.
#   off (default) | local (BYO JSON file under .memory/, no Azure) | cosmos | foundry
# A --memory flag on the command line overrides this value.
MEMORY_MODE=off

# --- Cosmos DB for --memory cosmos (Part E, shared multi-instance store). Optional. ---
# KEYLESS (recommended): set the endpoint; the app authenticates with DefaultAzureCredential.
# The identity needs the Cosmos DB Built-in Data Contributor DATA-PLANE role (control-plane
# Owner is NOT enough). Provision the account + role with infra/provision-cosmos.ps1.
COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE=agentmemory
COSMOS_CONTAINER=conversations
# LOCAL EMULATOR / dev only (key-based; the emulator does not support AAD). If set, this wins
# over COSMOS_ENDPOINT. Use the well-known emulator key from Microsoft Learn:
# COSMOS_CONNECTION_STRING=AccountEndpoint=https://localhost:8081/;AccountKey=<well-known-emulator-key>

# --- Foundry-managed Memory for --memory foundry (Part E, PLATFORM-managed tier). Optional. ---
# Reuses FOUNDRY_PROJECT_ENDPOINT / FOUNDRY_MODEL above. This tier is a managed context provider on a
# SINGLE agent + session (not the IMemoryStore BYO seam) — the service extracts, embeds, and recalls
# automatically. Requires: an EMBEDDING deployment, Foundry "Memory (preview)" enabled, and the
# account + project managed identities granted "Cognitive Services OpenAI User" so the service can call
# your deployments. Provision the role grant with infra/provision-foundry-memory.ps1.
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_AI_MEMORY_STORE_ID=lab06-agent-memory
