# Copy to .env and fill in (same values you used in Lab 03).
# The Microsoft Agent Framework reads FOUNDRY_PROJECT_ENDPOINT / FOUNDRY_MODEL.
# Find the endpoint on your AI Foundry project overview page.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-4o

# Lab 03 fallback names are also accepted by banking_agents.get_client():
# PROJECT_ENDPOINT=...
# MODEL_DEPLOYMENT_NAME=gpt-4o

# Which demo customer this session acts as (see data/customers.json: CUST-1001..1003).
DEMO_CUSTOMER_ID=CUST-1001
